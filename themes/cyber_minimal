{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "background": "#0D0D0D",
          "foreground": "#00FFC8",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " {{ .Icon }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#111111",
          "foreground": "#444444",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#161616",
          "foreground": "#00FFC8",
          "template": " \uf07c {{ .Path }} ",
          "properties": {
            "style": "folder",
            "max_depth": 3,
            "home_icon": "\uf015"
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#1A1A2E",
          "foreground": "#FFD700",
          "template": " \ue235 {{ if .Venv }}{{ .Venv }}{{ else }}{{ .Full }}{{ end }} ",
          "properties": {
            "display_mode": "context",
            "fetch_version": true
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#0D1B0D",
          "foreground": "#68A063",
          "template": " \ue718 {{ .Full }} ",
          "properties": {
            "display_mode": "context",
            "fetch_version": true
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#1A1A1A",
          "foreground": "#00FFC8",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#2A1400{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#1A001A{{ end }}",
            "{{ if gt .Ahead 0 }}#001A1A{{ end }}"
          ],
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9500{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#CC44FF{{ end }}",
            "{{ if gt .Ahead 0 }}#00FFC8{{ end }}"
          ],
          "template": " \ue0a0 {{ .HEAD }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .Ahead 0 }} \uf55c {{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \uf55b {{ .Behind }}{{ end }} ",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "background": "#00FFC8",
          "foreground": "#0D0D0D",
          "background_templates": [
            "{{ if gt .Code 0 }}#FF2D55{{ end }}"
          ],
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FFFFFF{{ end }}"
          ],
          "trailing_diamond": "\ue0b4",
          "template": " {{ if gt .Code 0 }}\uf00d {{ .Code }}{{ else }}\uf00c{{ end }} ",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#00FFC8",
          "template": "\u276f "
        }
      ]
    }
  ]
}
