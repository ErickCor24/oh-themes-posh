{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "shell",
          "style": "diamond",
          "background": "#381438", 
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#FFFFFF",
          "template": "󰞅 {{ .Name }}"
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#FFFFFF",
          "template": " {{ .CurrentDate | date \"15:04\" }} | "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#E044FF",
          "template": "{{ if .Venv }}({{ .Venv }}){{ end }} ",
          "properties": {
            "display_mode": "environment",
            "fetch_version": false,
            "folder_name_fallback": false
          }
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#67AEFF",
          "template": "󰝰 {{ .Path }} | ",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#ff4400",
          "template": "({{ .HEAD }})"
        }
      ]
    }
  ]
}